<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.fxterm</groupId>
        <artifactId>fxterm-tabs-parent</artifactId>
        <version>0.1.6</version>
    </parent>
    <artifactId>fxterm-tabs</artifactId>

    <properties>
        <main.class>fxterm.tabs.Main</main.class>
        <exec.mainClass>${main.class}</exec.mainClass>
    </properties>

    <dependencies>
        <dependency><groupId>io.github.fxterm</groupId><artifactId>fxterm-jeditermfx-ui</artifactId></dependency>
        <dependency><groupId>com.techsenger.jeditermfx</groupId><artifactId>jeditermfx-core</artifactId></dependency>
        <dependency><groupId>org.jetbrains.pty4j</groupId><artifactId>pty4j</artifactId></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId><classifier>${javafx.classifier}</classifier></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId><classifier>${javafx.classifier}</classifier></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><classifier>${javafx.classifier}</classifier></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-swing</artifactId><classifier>${javafx.classifier}</classifier></dependency>
        <dependency><groupId>io.github.prosemirrorfx</groupId><artifactId>prosemirrorfx-writer</artifactId></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-nop</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    </dependencies>

    <build>
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <!-- version.txt only: the version Tabs was built as, for the footer's update check -->
            <resource><directory>src/main/filtered</directory><filtering>true</filtering></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <outputFile>${project.basedir}/../shade/${shade.name}.jar</outputFile>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries><Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access></manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The Windows exe (jr): runs the jar in its own process, named fxterm-tabs. Two modes, same config:
                 - an ordinary build (mvn verify): source=path. The exe runs dist/fxterm-tabs.jar as it is (jr does
                   not hash a path source), so deploying a newer local build is copying a jar and an exe into dist
                   (restart.cmd). It keeps updateUrl, so when GitHub really has a newer release than this build
                   (Tabs' own UpdateCheck.newer decides, by number) one click in the footer updates it in place.
                   The pom version runs ahead of the last release, which is what keeps GitHub from downgrading it.
                 - the release (release.ps1: -Djr.source=url, in a clean clone): the exe fetches its jar from the
                   GitHub release, checked by SHA-256, and -Xjr:update moves it to the next release.
                 jr itself compares by position in the update file, not by number: an exe whose version is not in
                 the file is told to update, so -Xjr:update typed by hand on a local build WOULD replace it with the
                 release. -->
            <plugin>
                <groupId>io.github.jarrunner</groupId>
                <artifactId>jr-maven-plugin</artifactId>
                <version>1.3.0</version>
                <executions>
                    <execution>
                        <!-- verify, after package's shade, so it hashes the jar just written -->
                        <phase>verify</phase>
                        <goals><goal>exe</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <jar>${project.basedir}/../shade/${shade.name}.jar</jar>
                    <jarPath>${project.basedir}/../dist/${shade.name}.jar</jarPath>
                    <icon>${project.basedir}/fxterm-tabs.ico</icon>
                    <fileDescription>Tabs (FxTerminalTabs)</fileDescription>
                    <productName>Tabs</productName>
                    <companyName>fxterm</companyName>
                    <copyright>fxterm contributors</copyright>
                    <javaVersion>25+</javaVersion>
                    <jvmMode>dll</jvmMode>
                    <vmArgs>
                        <vmArg>-Xms16m</vmArg>
                        <vmArg>-Xmx128m</vmArg>
                        <vmArg>-XX:MaxNewSize=32m</vmArg>
                        <vmArg>-XX:+UseSerialGC</vmArg>
                        <vmArg>-XX:MinHeapFreeRatio=10</vmArg>
                        <vmArg>-XX:MaxHeapFreeRatio=30</vmArg>
                        <vmArg>-Xss512k</vmArg>
                        <vmArg>-XX:TieredStopAtLevel=1</vmArg>
                        <vmArg>-XX:ReservedCodeCacheSize=32m</vmArg>
                        <vmArg>-XX:MaxMetaspaceSize=96m</vmArg>
                        <vmArg>--enable-native-access=ALL-UNNAMED</vmArg>
                    </vmArgs>
                    <jarUrl>https://github.com/fxterm/tabs/releases/download/v${project.version}/${shade.name}.jar</jarUrl>
                    <updateUrl>https://github.com/fxterm/tabs/releases/latest/download/fxterm-tabs.update.json</updateUrl>
                    <supportName>fxterm</supportName>
                    <supportIssues>https://github.com/fxterm/tabs/issues</supportIssues>
                    <supportUrl>https://github.com/fxterm/tabs</supportUrl>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
